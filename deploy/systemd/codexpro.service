# systemd user unit for the CodexPro HTTP MCP connector, socket-activated.
# Requires codexpro.socket (same name). `systemctl --user restart codexpro`
# then means: SIGTERM -> old process stops accepting, finishes in-flight tool
# calls (CODEXPRO_DRAIN_TIMEOUT_MS), exits; new process accepts the queued
# connections. MCP sessions re-initialise once (404 -> initialize).
[Unit]
Description=CodexPro HTTP MCP connector
Documentation=https://github.com/lyeith/codexpro
Requires=codexpro.socket
After=network-online.target codexpro.socket
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/codexpro-go/current
EnvironmentFile=%h/.config/codexpro/env
Environment=CODEXPRO_DRAIN_TIMEOUT_MS=60000
Environment=CODEXPRO_ENV_FILE=%h/.config/codexpro/env
ExecStart=%h/apps/codexpro-go/current/codexpro-go --state-dir %h/.codexpro-go/state --token-file %h/.config/codexpro/http-token
ExecReload=/bin/kill -HUP $MAINPID
# SIGTERM goes to the server, which drains accepted MCP requests.
# Remaining service children are killed after TimeoutStopSec.
KillMode=mixed
TimeoutStopSec=75
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=full
StandardOutput=null
StandardError=journal
SyslogIdentifier=codexpro

[Install]
WantedBy=default.target
