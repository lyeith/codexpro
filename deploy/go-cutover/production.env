# Production instance for cutover.sh / rollback.sh (sourced by bash).
INSTANCE=production
UNIT=codexpro
BASE_URL=http://127.0.0.1:7200
TS_HOME=$HOME/.codexpro
GO_STATE=$HOME/.codexpro-go/state
TOKEN_FILE=$HOME/.config/codexpro/http-token
# The release that contains these scripts (run them from the release directory).
RELEASE="$(cd "$HERE/../.." && pwd)"
DROPIN_DIR=$HOME/.config/systemd/user/codexpro.service.d
DROPIN_NAME=70-codexpro-go.conf
EVIDENCE_ROOT=$HOME/Projects/codexpro-cutover-evidence
SMOKE_PROJECT=codexpro
SMOKE_READ_PATH=README.md
# All codexpro-job_* scopes on the host belong to production TypeScript at cutover.
GLOBAL_SCOPE_CENSUS=1
