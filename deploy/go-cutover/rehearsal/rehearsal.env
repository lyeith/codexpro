# Temporary rehearsal instance (created by rehearsal/setup.sh, removed by teardown.sh).
INSTANCE=rehearsal
UNIT=codexpro-rehearsal
R=$HOME/Projects/codexpro-cutover-evidence/rehearsal
BASE_URL=http://127.0.0.1:7212
TS_HOME=$R/ts-home
GO_STATE=$R/go-state
TOKEN_FILE=$R/config/http-token
# The release that contains these scripts (run them from the release directory).
RELEASE="$(cd "$HERE/../.." && pwd)"
DROPIN_DIR=$HOME/.config/systemd/user/codexpro-rehearsal.service.d
DROPIN_NAME=70-codexpro-go.conf
EVIDENCE_ROOT=$HOME/Projects/codexpro-cutover-evidence
SMOKE_PROJECT=scratch
SMOKE_READ_PATH=README.md
# Production TypeScript keeps running jobs: count only this instance's records.
GLOBAL_SCOPE_CENSUS=0
CATALOG=$R/config/projects.json
