# Copy into the private EnvironmentFile used by codexpro.service.
CODEXPRO_PROJECTS_FILE=/absolute/path/to/projects.json

# Standalone listener. The socket unit owns the listener under systemd.
# CODEXPRO_HOST=127.0.0.1
# CODEXPRO_PORT=7210

# Shared Plans Access policy and temporary shared-token bridge.
# CODEXPRO_PRINCIPALS_FILE=/absolute/path/to/private/principals.json
# CODEXPRO_LEGACY_BRIDGE=true

# Optional integrations and dependency paths.
# CODEXPRO_PENDING_MAIL_SOCKET=/absolute/path/to/agentmail.sock
# CODEXPRO_PLANS_ACCESS_COMMAND=/absolute/path/to/plans-access
# CODEXPRO_AST_GREP_PATH=/absolute/path/to/ast-grep
# CODEXPRO_GO_WORK_HISTORY=/absolute/private/path/to/work.sqlite
# CODEXPRO_HOST_RESOURCES_HELPER=/absolute/path/to/ssd-dev
# AGENTMAIL_TOKEN_FILE=/absolute/path/to/agentmail-token

# Configuration
# CODEXPRO_TOOL_MODE=standard
# CODEXPRO_AUDIT_MODE=metadata
# CODEXPRO_BLOCKED_GLOBS=**/secrets/**,**/*.sqlite,**/*.db
# CODEXPRO_DRAIN_TIMEOUT_MS=60000

# These limits can change on SIGHUP. Use decimal integers.
# CODEXPRO_MAX_OUTPUT_BYTES=120000
# CODEXPRO_MAX_BASH_TIMEOUT_MS=600000
# CODEXPRO_BASH_TIMEOUT_MS=120000
# CODEXPRO_JOB_TIMEOUT_MS=2700000
# CODEXPRO_MAX_JOBS=12
# CODEXPRO_MAX_JOBS_PER_WORKSPACE=6
# CODEXPRO_MAX_JOB_OUTPUT_BYTES=8388608
# CODEXPRO_JOB_RETENTION_MS=86400000
# CODEXPRO_MAX_RETAINED_JOB_BYTES=536870912
# CODEXPRO_MAX_JOB_HISTORY_PER_WORKSPACE=50
# CODEXPRO_AUDIT_MAX_BYTES=8388608
# CODEXPRO_AUDIT_RETAIN_ACTIONS=350
# CODEXPRO_ACCESS_LOG=false
